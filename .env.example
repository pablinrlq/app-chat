# Credenciais AWS (se vazias, o SDK usa a cadeia padrão: IAM role / ~/.aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Nome da tabela (opcional, padrão: MensagensChat)
DYNAMODB_TABLE=MensagensChat

# Para testar localmente com DynamoDB Local, descomente:
# DYNAMODB_ENDPOINT=http://localhost:8000

# Com múltiplas instâncias atrás de um load balancer, aponte para o Redis
# (ElastiCache) para o broadcast do socket.io atravessar as instâncias:
# REDIS_URL=redis://seu-endpoint-elasticache:6379
